# ─── Clover — конфигурация ─────────────────────────────────────────────────
# Скопируй в .env и поменяй значения под себя:  cp .env.example .env
# .env НЕ коммитится (в .gitignore).

# Порт сервиса
PORT=3000

# Админ панели. Если ОБЕ переменные заданы — этот логин/пароль применяются
# при КАЖДОМ запуске (на существующей базе пароль синхронизируется, сессии
# сбрасываются). Если не заданы — на пустой базе создаётся admin/admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Путь к бинарю сканера, который отдаётся игрокам
CLOVER_EXE_PATH=./clover.exe

# Путь к файлу SQLite-базы (только когда НЕ задан DATABASE_URL)
# CLOVER_DB_PATH=./data/clover.db

# ─── База данных ────────────────────────────────────────────────────────────
# Без DATABASE_URL — SQLite в data/clover.db (локалка, ноль настройки).
# С DATABASE_URL — PostgreSQL; эту же строку вставляешь в DBeaver/DataGrip
# и смотришь/правишь данные напрямую.
#
# DATABASE_URL=postgres://clover:ПАРОЛЬ@localhost:5432/clover
#
# Для docker-compose: пароль Postgres берётся отсюда же (POSTGRES_PASSWORD):
# POSTGRES_PASSWORD=смени-мэня

# ─── Уведомления о новых сканах (опционально) ──────────────────────────────
# Удобнее задавать на странице «Настройки» (/settings) в панели — значения
# оттуда хранятся в БД и имеют приоритет над этими переменными.
# Telegram-бот: токен от @BotFather и chat_id (группа/канал/личка).
# TG_BOT_TOKEN=123456:ABCDEF...
# TG_CHAT_ID=-1001234567890
# Discord webhook канала:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Публичный адрес панели — добавляет ссылку на скан в уведомления.
# PUBLIC_BASE_URL=https://clover.example.com

# ─── AI-анализ сканов (опционально, внешний LLM API) ───────────────────────
# OpenAI-совместимый endpoint chat completions + ключ + модель.
# Когда задано — на странице скана работает кнопка «AI-анализ».
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
