# ─── Clover — конфигурация ─────────────────────────────────────────────────
# Скопируй в .env и поменяй значения под себя:  cp .env.example .env
# .env НЕ коммитится (в .gitignore).

# Порт сервиса
PORT=3000

# Первый админ — создаётся ТОЛЬКО при самом первом запуске (когда база пустая).
# Если база уже есть (data/clover.db), эти переменные ни на что не влияют.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Путь к бинарю сканера, который отдаётся игрокам
CLOVER_EXE_PATH=./clover.exe
